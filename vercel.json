{
  "redirects": [
    {
      "source": "/v2",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/v2/:path*",
      "destination": "/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/catalog",
      "destination": "/catalog.html"
    },
    {
      "source": "/catalog/:path*",
      "destination": "/catalog.html"
    }
  ]
}
