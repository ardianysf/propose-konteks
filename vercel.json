{
  "rewrites": [
    {
      "source": "/catalog",
      "destination": "/catalog.html"
    },
    {
      "source": "/catalog/:path*",
      "destination": "/catalog.html"
    },
    {
      "source": "/v2",
      "destination": "/v2.html"
    },
    {
      "source": "/v2/:path*",
      "destination": "/v2.html"
    }
  ]
}
