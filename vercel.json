{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"static site, nothing to install\"",
  "buildCommand": "echo \"static site, nothing to build\"",
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/design-system",
      "destination": "/prototype.html"
    },
    {
      "source": "/login",
      "destination": "/prototype.html"
    },
    {
      "source": "/app",
      "destination": "/prototype.html"
    }
  ],
  "headers": [
    {
      "source": "/code/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/landingpage",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/prototype",
      "destination": "/design-system",
      "permanent": false
    },
    {
      "source": "/index",
      "destination": "/",
      "permanent": false
    }
  ]
}
