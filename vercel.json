{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "echo \"static site, nothing to install\"",
  "buildCommand": "echo \"static site, nothing to build\"",
  "outputDirectory": "site",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/landingpage", "destination": "/landingpage.html" }
  ],
  "headers": [
    { "source": "/code/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=300" }] }
  ]
}
