{
  "redirects": [
    {
      "source": "/",
      "destination": "/catalog",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/v2",
      "destination": "/index.html"
    },
    {
      "source": "/v2/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/landingpage",
      "destination": "/landingpage.html"
    },
    {
      "source": "/pricing",
      "destination": "/pricing.html"
    },
    {
      "source": "/pricing/",
      "destination": "/pricing.html"
    },
    {
      "source": "/docs",
      "destination": "/docs.html"
    },
    {
      "source": "/docs/",
      "destination": "/docs.html"
    },
    {
      "source": "/blog",
      "destination": "/journal.html"
    },
    {
      "source": "/blog/",
      "destination": "/journal.html"
    },
    {
      "source": "/catalog",
      "destination": "/catalog.html"
    },
    {
      "source": "/catalog/:path*",
      "destination": "/catalog.html"
    }
  ]
}
